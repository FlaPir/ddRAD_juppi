library(dplyr)
library(readr)
library(stringr)
library(ggplot2)
library(gggenes)
library(ggrepel)

file_gff3 <- "path/to/Culex_pipiens_annotated_genome.gff3"
gff_raw <- read_tsv(file_gff3, comment = "#", 
                    col_names = c("Chrom", "source", "type", "Start", "End", "score", "Strand", "phase", "attributes"),
                    show_col_types = FALSE)
                    
gff_clean <- gff_raw %>%
  filter(type == "gene") %>% 
  mutate(
    
    Gene_ID_base = str_extract(attributes, "(?<=ID=)[^;]+"),
    Gene_ID_base = str_replace(Gene_ID_base, "gene-", ""),
    Gene_ID_base = str_replace(Gene_ID_base, "\\..*", ""),
  
    Gene_Symbol  = str_extract(attributes, "(?<=Name=)[^;]+"),
    Gene_Symbol  = ifelse(Gene_Symbol == "n/a", NA, Gene_Symbol), # Clean up missing names
    
    Function     = str_extract(attributes, "(?<=product=)[^;]+")
  ) %>%
  dplyr::select(Chrom, Start, End, Strand, Gene_ID_base, Gene_Symbol, Function)


plot_locus_and_export_functional_list <- function(gene_id_target, window = 40000, output_folder = "") {

  coords <- gff_clean %>% 
    dplyr::filter(Gene_ID_base == gene_id_target) %>% 
    dplyr::slice(1)
  
  if(nrow(coords) == 0) stop("Target Gene ID not found in GFF3 data!")
  
  plot_df <- gff_clean %>%
    dplyr::filter(Chrom == coords$Chrom) %>%
    dplyr::filter(Start >= (coords$Start - window) & End <= (coords$End + window)) %>%
    arrange(Start) %>% 
    mutate(
      is_target = ifelse(Gene_ID_base == gene_id_target, "YES", "NO"),
      midpoint  = (Start + End) / 2,
      direction = ifelse(Strand == "+", TRUE, FALSE),
      
      # Stagger text vertically to avoid overlapping (alternates between 0.6 and 1.3)
      text_offset = rep(c(0.6, 1.3), length.out = n())
    )
  
#to export a list of genes involved in the selected span
  gene_list_to_save <- plot_df %>%
    dplyr::select(Chrom, Start, End, Strand, 
                  Gene_ID = Gene_ID_base, 
                  Gene_Symbol, 
                  Function, 
                  Is_Target = is_target)
  
  csv_filename <- paste0(output_folder, "Detailed_Gene_List_", gene_id_target, ".csv")
  write_csv(gene_list_to_save, csv_filename)
  
  p <- ggplot(plot_df, aes(xmin = Start, xmax = End, y = Chrom, 
                           fill = is_target, forward = direction)) +
    geom_hline(aes(yintercept = Chrom), color = "grey80", linewidth = 0.5) +
    geom_gene_arrow(arrowhead_height = unit(4, "mm"), 
                    arrowhead_width = unit(2, "mm"),
                    color = "black", linewidth = 0.3) +
    geom_text_repel(aes(x = midpoint, label = Gene_ID_base),
                    nudge_y      = plot_df$text_offset,
                    direction    = "y",
                    size         = 3.2, 
                    fontface     = "bold.italic",
                    segment.size = 0.2,
                    segment.color = "grey50",
                    box.padding  = 0.5,
                    max.overlaps = Inf) +
    scale_fill_manual(values = c("YES" = "#d73027", "NO" = "#f7f7f7")) +
    theme_genes() +
    scale_y_discrete(expand = expansion(mult = c(0.5, 4))) + 
    theme(
      legend.position = "none",
      plot.title = element_text(face = "bold", size = 16, hjust = 0.5),
      plot.subtitle = element_text(size = 10, color = "grey30", hjust = 0.5),
      axis.ticks.x = element_blank(),
      panel.grid.major.x = element_blank(),
      panel.grid.minor.x = element_blank(),
      panel.grid.major.y = element_blank(),
      axis.line.x = element_line(color = "black")
    ) +
    labs(title = paste("Locus map:", gene_id_target),
         subtitle = paste("Window span: +/-", window / 1000, "kb"),
         x = "Genomic position (bp)", y = "")
  
  return(p)
}


FOLDER_PATH    <- "path/to/output_folder"
TARGET_GENE_ID <- "g10399"
WINDOW_SIZE    <- 40000  #window size (+/- 40kb)

locus_plot <- plot_locus_and_export_functional_list(TARGET_GENE_ID, window = WINDOW_SIZE, output_folder = FOLDER_PATH)
print(locus_plot)

image_output_path <- paste0(FOLDER_PATH, "Locus_Map_", TARGET_GENE_ID, ".tif")
ggsave(
  filename = image_output_path, 
  plot = locus_plot, 
  device = "tiff", 
  width = xx, 
  height = xx, 
  dpi = 600, 
  compression = "lzw"
)

message("--> TIFF image successfully saved to: ", image_output_path)
